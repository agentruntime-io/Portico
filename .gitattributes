# Normalize line endings to LF in the repository.
# Editors on Windows will still work; Git stores LF consistently for CI and collaborators.
* text=auto eol=lf

# Explicit binary files — do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
