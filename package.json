{
  "name": "portico",
  "version": "0.2.0",
  "description": "Portico — self-hosted documentation portal from AgentRuntime (https://www.agentruntime.io). Open source.",
  "private": false,
  "author": "AgentRuntime <https://www.agentruntime.io>",
  "homepage": "https://www.agentruntime.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentruntime-io/Portico.git"
  },
  "bugs": {
    "url": "https://github.com/agentruntime-io/Portico/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "documentation",
    "docs-site",
    "docs-as-code",
    "mdx",
    "openapi",
    "api-reference",
    "nextjs",
    "self-hosted",
    "portico",
    "agentruntime"
  ],
  "scripts": {
    "predev": "node scripts/sync-content-assets.mjs && node scripts/generate-search.mjs",
    "prebuild": "node scripts/sync-content-assets.mjs && node scripts/generate-search.mjs",
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-text": "^4.0.2",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.18.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "5.0.12",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "browserslist": "4.28.7",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "postcss-selector-parser": "6.1.5",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  }
}
